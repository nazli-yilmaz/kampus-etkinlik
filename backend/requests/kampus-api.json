{
  "info": {
    "name": "Kampüs API",
    "description": "Sprint 8 - Express ve MongoDB/Mongoose REST API istek koleksiyonu",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "eventId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/health"
      }
    },
    {
      "name": "Get All Events",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (Array.isArray(response) && response.length > 0) {",
              "    pm.collectionVariables.set(\"eventId\", response[0]._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/events"
      }
    },
    {
      "name": "Get Event By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/events/{{eventId}}"
      }
    },
    {
      "name": "Get Invalid / Non-Existing Event",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/events/gecersiz-id-123"
      }
    },
    {
      "name": "Filter Events By Category",
      "request": {
        "method": "GET",
        "header": [],
        "url": "http://localhost:3000/events?category=Atölye"
      }
    },
    {
      "name": "Create Event - Success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Yeni Etkinlik\",\n  \"category\": \"Atölye\",\n  \"date\": \"2026-11-20\",\n  \"capacity\": 25,\n  \"time\": \"14:00\",\n  \"location\": \"Lab 1\",\n  \"description\": \"Test etkinliği\"\n}"
        },
        "url": "http://localhost:3000/events"
      }
    },
    {
      "name": "Create Event - Missing Data",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Eksik Veri Testi\"\n}"
        },
        "url": "http://localhost:3000/events"
      }
    }
  ]
}
